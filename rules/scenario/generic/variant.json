{
  "subsystem": "scenario",
  "id": "generic",
  "version": "1.0.0",
  "status": "stable",
  "description": "通用剧本：选算子 + 势力/数值覆盖 + 部署/援军",
  "configFile": "scenario.json",
  "requires": ["map", "counter"],
  "provides": ["scenario", "deployment", "reinforcements"],
  "configSchema": {
    "units": [
      {
        "counter": "算子键(对应 units.json)",
        "owner": "玩家编号(0起)",
